<!-- filepath: persistence.xml -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="progweb">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>uce.edu.ec.db.Album</class>
        <class>uce.edu.ec.db.Comment</class>
        <class>uce.edu.ec.db.Photo</class>
        <class>uce.edu.ec.db.Post</class>
        <class>uce.edu.ec.db.Todo</class>
        <class>uce.edu.ec.db.User</class>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/progweb"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="postgres"/>
<!--            //PARA CREAR LA BASE DE DATOS-->
<!--            <property name="jakarta.persistence.schema-generation.create-source" value="ddl.sql"/>-->
<!--            <property name="jakarta.persistence.sql-load-script-source" value="import.sql"/>-->
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>